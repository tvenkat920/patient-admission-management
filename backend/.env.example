# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration (SQLite locally, PostgreSQL in production)
# For local development: sqlite:///./patients.db
# For production (Render / PostgreSQL): postgresql://...
DATABASE_URL=sqlite:///./patients.db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tvenkat920.github.io
SEED_IF_EMPTY=false
